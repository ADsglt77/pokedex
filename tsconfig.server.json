{
  // Le serveur : du code lancé par Bun, sans les types du navigateur (`DOM`) : un `document` ou un
  // `window` glissé dans le code qu'il partage avec l'app (`src/lib`) ne passerait pas.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["bun"]
  },
  "include": ["server"]
}
