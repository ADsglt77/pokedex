{
  // Les tests que lance Bun (`bun test`, qui importent du code de l'app), et les configurations de
  // Vite, Vitest et Drizzle Kit (sous Node). Sans les types du navigateur (`DOM`) : un `document`
  // ou un `window` glissé dans le code qu'ils partagent avec l'app (`src/lib`) ne passerait pas.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.bun.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["bun"]
  },
  "include": ["tests", "vite.config.ts", "vitest.config.ts", "drizzle.config.ts"]
}
