{
  // Les options communes à l'app (`tsconfig.app.json`) et à ce que lance Bun (`tsconfig.bun.json`) ;
  // chacun ajoute ses `lib`, `types` et `include`.
  "compilerOptions": {
    // Le défaut de TypeScript 6, écrit pour qui lit ce fichier.
    "strict": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  }
}
