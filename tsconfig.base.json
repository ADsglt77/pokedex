{
  // Les options communes à l'app (`tsconfig.app.json`), à ce que lance Bun (`tsconfig.bun.json`),
  // au Worker (`tsconfig.worker.json`) et au contrôle des types partagés
  // (`tsconfig.contracts.json`) ;
  // chacun y ajoute les siens (`lib`, `types`, `include`).
  "compilerOptions": {
    // Le défaut de TypeScript 6, écrit pour qui lit ce fichier.
    "strict": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  }
}
