{
  "name": "pokedex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc -b && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "dev:server": "bun --watch server/index.ts",
    "lint": "eslint . && knip",
