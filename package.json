{
  "name": "pokedex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "lint": "eslint . && knip",
    "lint:ci": "eslint . && knip --config knip.ci.json",
    "knip": "knip",
    "contracts": "tsc -p tsconfig.contracts.json",
    "test": "bun test",
    "test:worker": "vitest run",
    "format": "prettier --write src/ worker/ tests/ scripts/",
    "ci": "bun test && bun run lint:ci && bun run test:worker && bun run build",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@camply/ui": "^0.4.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.41.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5",
    "wrangler": "^4.154.0",
    "zustand": "^5.0.15"
  }
}
