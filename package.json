    "format": "prettier --write src/ server/ tests/",
    "ingest": "bun server/ingest.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "better-auth": "^1.7.11",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@camply/ui": "^0.3.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.41.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
