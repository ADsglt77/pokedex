# Adresse publique exacte du site. En production, le serveur exige https.
BETTER_AUTH_URL=https://pokecodex.fr
# En développement (`bun dev`), remplacer la ligne du dessus par celle-ci, l'adresse de Vite : sans
# elle, tout enregistrement envoyé par Vite est refusé (403).
# BETTER_AUTH_URL=http://localhost:5173

# Secret des sessions : `openssl rand -base64 32` (32 caractères au moins en production).
BETTER_AUTH_SECRET=

# Même valeur que le token `pokedex:` de `pokedex-data/.env`.
DATA_API_TOKEN=
