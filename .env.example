# Adresse publique exacte du site. En production, le serveur exige https.
BETTER_AUTH_URL=https://pokecodex.fr

# Secret des sessions : `openssl rand -base64 48` (32 caractères au moins en production).
BETTER_AUTH_SECRET=

# Même valeur que le token `pokedex:` de `pokedex-data/.env`.
DATA_API_TOKEN=
