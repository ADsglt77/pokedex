# Le développement en local (`bun dev`) : à copier en `.env`, lu par Vite et par le Worker (le
# plugin Cloudflare). En ligne, rien de ce fichier : l'adresse est dans `wrangler.jsonc`, la clé
# est un secret du Worker (`wrangler secret put BETTER_AUTH_SECRET`).

# L'adresse de Vite : sans elle, tout enregistrement envoyé par Vite est refusé (403).
BETTER_AUTH_URL=http://localhost:5173

# La clé des sessions de ce poste seulement (32 caractères au moins) ; jamais celle du site en ligne.
BETTER_AUTH_SECRET=developpement-local-seulement-pas-le-secret-du-site
