{
  // Le Worker (`worker/`) et ses tests : les types de Cloudflare (et de `cloudflare:test`), sans
  // ceux du navigateur ni de Bun. Le code qu'il partage avec l'app (`src/lib`) passe donc aussi
  // sans eux.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["worker"]
}
