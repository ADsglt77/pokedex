{
  // Les tests (`bun test`) : lancés par Bun, ils importent le serveur et du code de l'app.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"]
  },
  "include": ["tests"]
}
