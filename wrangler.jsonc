// Le Worker du site (pokecodex.fr), lu par Wrangler, le plugin Cloudflare de Vite (`bun dev`,
// `bun run build`) et les tests du Worker (`vitest.config.ts`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokecodex",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // Better Auth s'appuie sur des modules de Node (`AsyncLocalStorage`).
  "compatibility_flags": ["nodejs_compat"],
  // Les fichiers de l'app, construits par Vite. Toute requête passe d'abord par le Worker, qui les
  // demande à `ASSETS` (`worker/index.ts`) : seul lui peut donner son aperçu à un robot qui lit
  // `/pseudo`. Une adresse qui n'est pas un fichier donne `index.html` : le routeur de l'app s'en
  // charge.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // Les comptes (`worker/schema.ts`), leurs migrations écrites par Drizzle (`bun run db:generate`).
  // En ligne, la base créée dans l'Union européenne (`--jurisdiction eu`, `docs/deploiement.md`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokecodex",
      "database_id": "fd6f7213-f55d-43fa-baaf-b24cb62e2442",
      // La base locale (`.wrangler/`) reste celle rangée sous le nom de la liaison : avec
      // l'identifiant de la base en ligne, Wrangler en ouvrirait une neuve, vide.
      "preview_database_id": "DB",
      "migrations_dir": "worker/migrations",
    },
  ],
  // Le Worker des données (le dépôt `pokedex-data`), son entrée pour le site : sans token ni
  // réseau entre les deux (`worker/data.ts`).
  "services": [{ "binding": "DATA", "service": "pokedex-data", "entrypoint": "SiteEntrypoint" }],
  // Les limites par visiteur (`worker/limits.ts`), par 10 s : chacune loin de ce que demande une
  // visite (la collection : un envoi toutes les 0,5 s par onglet au plus ; les prix d'une collection
  // de 5 000 cartes : 25 demandes à la première page ; le Pokédex : 1 025 pochettes). Leurs
  // `namespace_id` ne doivent pas reprendre ceux du Worker des données (1001, 1002) : ils sont
  // partagés par tout le compte Cloudflare.
  "ratelimits": [
    { "name": "COLLECTION_LIMIT", "namespace_id": "2001", "simple": { "limit": 40, "period": 10 } },
    { "name": "ACCOUNT_LIMIT", "namespace_id": "2002", "simple": { "limit": 40, "period": 10 } },
    { "name": "HEAVY_LIMIT", "namespace_id": "2003", "simple": { "limit": 30, "period": 10 } },
    { "name": "DATA_LIMIT", "namespace_id": "2004", "simple": { "limit": 400, "period": 10 } },
    { "name": "IMAGES_LIMIT", "namespace_id": "2005", "simple": { "limit": 1300, "period": 10 } },
  ],
  // L'adresse publique du site ; en développement, celle de Vite (`.env`, qui la remplace). La clé
  // des sessions (`BETTER_AUTH_SECRET`) est un secret du Worker, jamais dans ce fichier.
  "vars": { "BETTER_AUTH_URL": "https://pokecodex.fr" },
  // En ligne à son adresse seulement (le domaine sur Cloudflare : `docs/deploiement.md`) ; `www`
  // y mène (`worker/headers.ts`). Ni l'adresse `workers.dev` ni celle des aperçus : les sessions
  // n'y marcheraient pas (Better Auth n'accepte que `BETTER_AUTH_URL`).
  "routes": [
    { "pattern": "pokecodex.fr", "custom_domain": true },
    { "pattern": "www.pokecodex.fr", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
