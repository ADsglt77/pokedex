{
	email contact@pokecodex.fr
}

# Le site, relayé vers nginx. `X-Forwarded-For` : l'adresse du visiteur, seule (Caddy ne se fie à
# aucun relais, pas de `trusted_proxies` : il remplace celle reçue du public). nginx et le serveur
# en dépendent (`server/auth.ts`, `advanced.ipAddress`) : un relais de plus devant Caddy changerait
# cet en-tête.
pokecodex.fr {
	reverse_proxy 127.0.0.1:8080
}

# La redirection vers le site, avec le même HSTS que lui (`deploy/security-headers.conf`, posé par
# nginx) : `www` aussi en https seulement.
www.pokecodex.fr {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://pokecodex.fr{uri} permanent
}
