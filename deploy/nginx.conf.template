# Le gabarit de la configuration de nginx : l'image nginx le remplit au démarrage depuis son
# environnement (`/etc/nginx/templates`), seulement les variables qu'elle connaît : le token du site
# pour l'API des données, `${DATA_API_TOKEN}` (son `.env`, `compose.yaml`). Les variables de nginx,
# sans accolades, restent telles quelles.

# Les images de l'API des données, gardées sur le disque de nginx : une image ne change jamais
# (l'API ne réécrit pas un fichier qui existe), chacune ne traverse qu'une fois. Perdues à la
# reconstruction du conteneur : l'API les redonne, sans rien télécharger. Sur le disque, 12 Go :
# tous les scans, japonais et français, y tiennent (environ 3 Go) avec de la marge. En clés, 30 Mo :
# nginx en garde environ 8 000 par Mo, soit 240 000, pour environ 110 000 images (deux tailles par
# carte, japonaises et françaises, plus les logos et les icônes) ; avec 10 Mo, il évincerait les
# plus anciennes avant le disque, et « tous y tiennent » serait faux.
proxy_cache_path /var/cache/nginx/images levels=1:2 keys_zone=images:30m max_size=12g
                 inactive=90d use_temp_path=off;

# Par visiteur : l'adresse que Caddy écrit dans `x-forwarded-for` avant de joindre nginx. Caddy
# ignore l'en-tête reçu du public, donc un visiteur ne peut pas choisir cette clé. Sans Caddy (en
# local), nginx utilise l'adresse de la connexion. nginx transmet l'en-tête au serveur tel quel,
# une seule adresse (jamais `$proxy_add_x_forwarded_for` : `server/auth.ts`, `advanced.ipAddress`). Les routes publiques coûteuses de l'API, la
# collection du compte, la connexion et les images sont ainsi limitées par visiteur ; au-delà, 429.
# Chaque limite est loin de ce que demande une visite (comptée à côté de chacune, plus bas).
map $http_x_forwarded_for $visitor_ip {
    ""      $binary_remote_addr;
    default $http_x_forwarded_for;
}
limit_req_zone $visitor_ip zone=api_heavy:10m rate=2r/s;
limit_req_zone $visitor_ip zone=api_auth:10m rate=2r/s;
limit_req_zone $visitor_ip zone=api_vitrine:10m rate=2r/s;
limit_req_zone $visitor_ip zone=api_collection:10m rate=2r/s;
limit_req_zone $visitor_ip zone=api_data:10m rate=10r/s;
limit_req_zone $visitor_ip zone=images_req:10m rate=20r/s;
limit_req_status 429;

# Les robots d'aperçu des messageries (Discord, WhatsApp…) qui lisent un lien partagé vers le Pokédex
# public d'un compte (`/pseudo`, toute adresse d'un seul segment) : ils ne lancent pas le JavaScript
# de l'app, le serveur leur fait une page à part, avec le pseudo et la progression
# (`/api/vitrine/<pseudo>/apercu`, `server/vitrine.ts`, la même liste) ; pour une page du site
# (`/connexion`), l'aperçu du site.
map "$http_user_agent|$uri" $vitrine_preview {
    default 0;
    "~*(discordbot|whatsapp|facebookexternalhit|twitterbot|slackbot|telegrambot|linkedinbot|skypeuripreview|redditbot|embedly).*\|/[A-Za-z0-9_-]+$" 1;
}

# Les moteurs de recherche : seules les pages publiques du site s'indexent (l'accueil, la connexion,
# l'inscription, les mentions légales) ; toute autre adresse de l'app, le Pokédex public de chaque
# compte compris, reçoit `X-Robots-Tag: noindex` (une valeur vide : pas d'en-tête). D'après
# l'adresse demandée (`$request_uri`, avec ses paramètres) : `$uri` vaut `/index.html` une fois la
# page de l'app choisie (`try_files`).
map $request_uri $robots {
    default noindex;
    "~^/(connexion|inscription|mentions-legales)?(\?|$)" "";
}

# Les espèces, que la coquille de l'app attend (`router.tsx`) : préchargées avec la page quand le
# navigateur a une session (le cookie de Better Auth, `__Secure-` en https), sans attendre le
# script (`Link`, comme une balise `preload` de `index.html` ; `crossorigin` : la même demande que
# le `fetch` de l'app). Jamais pour un visiteur : la connexion s'en passe. Une valeur vide : pas
# d'en-tête.
map $http_cookie $species_preload {
    default "";
    "~better-auth\.session_token=" "</api/species>; rel=preload; as=fetch; crossorigin";
}

server {
    listen 80;
    root /usr/share/nginx/html;
    # Ni la version de nginx dans les réponses, et les en-têtes de sécurité partout.
    server_tokens off;
    include /etc/nginx/security-headers.conf;
    # Aucun journal des requêtes (Caddy n'en tient pas non plus) : nginx ne garde pas l'adresse
    # des visiteurs. Ses erreurs restent dans la sortie du conteneur, sans elle (celle de la
    # connexion est celle de Docker, devant Caddy).
    access_log off;
    # Les pages en UTF-8, dit dans leur type (`text/html; charset=utf-8`).
    charset utf-8;
    # Une ligne de requête jusqu'à 16 Ko (8 Ko par défaut) : les 1 000 ids d'un paquet de la
    # collection (`/api/histories?ids=…`, de 7 à 8 Ko) y tiennent, avec de la marge.
    large_client_header_buffers 4 16k;

    # Niveau 6 plutôt que 1 (le défaut) : le code rétrécit, pour un coût serveur négligeable.
    # `gzip_proxied` : les réponses de l'API aussi (celles déjà compressées, en gzip, passent
    # telles quelles). `text/javascript` : le type que donne nginx aux scripts récents ; le
    # manifeste de l'app aussi.
    gzip on;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml;

    # Le serveur et l'API des données (son propre `compose.yaml`, le réseau `pokedex-net`),
    # retrouvés par le DNS de Docker à chaque requête (au plus 10 s de cache) : quand leur conteneur
    # redémarre, il peut changer d'adresse ; résolue une fois au démarrage de nginx, elle serait
    # périmée (502) jusqu'au prochain redémarrage de nginx.
    resolver 127.0.0.11 valid=10s;
    set $server http://server:3000;
    set $data_api http://data-api:3001;

    # L'ordre de choix d'une `location` : une exacte (`=`) d'abord ; sinon la plus longue des
    # préfixes est retenue, mais la première expression régulière (`~`, dans l'ordre du fichier)
    # qui correspond passe avant elle.

    # Fichiers produits par Vite, au nom unique (empreinte) : gardés un an par les navigateurs.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Le serveur de l'app (compte, collection, Pokédex public) : il donne lui-même ses en-têtes de
    # cache. Des tampons d'1 Mo en mémoire, assez pour ses réponses.
    location /api/ {
        proxy_pass $server;
        proxy_set_header Host $host;
        client_max_body_size 5m;
        proxy_buffers 128 8k;
    }

    # La collection du compte (`GET` et `PUT /api/collection`, avec ou sans barre finale) : sans
    # limite, un visiteur ferait lire et contrôler au serveur des corps de 5 Mo à volonté. 2 par
    # seconde et par visiteur, 20 d'un coup au plus : l'app n'enregistre qu'une fois toutes les
    # 0,5 s par onglet (`src/store/account.ts`), plus ses reprises. Le reste est celui de `/api/`.
    location ~ ^/api/collection/?$ {
        limit_req zone=api_collection burst=20 nodelay;
        proxy_pass $server;
        proxy_set_header Host $host;
        client_max_body_size 5m;
        proxy_buffers 128 8k;
    }

    # Le Pokédex public d'un compte (sa collection, et les prix que le serveur demande à l'API des
    # données) et l'aperçu d'un lien partagé (les robots, plus bas) : une demande par page ouverte ;
    # 2 par seconde et par visiteur, 20 d'un coup au plus.
    location /api/vitrine/ {
        limit_req zone=api_vitrine burst=20 nodelay;
        proxy_pass $server;
        proxy_set_header Host $host;
        proxy_buffers 128 8k;
    }

    # Les données (espèces, état des tâches) : l'API des données, sous `/v1`, avec le token du site
    # (le navigateur ne le voit jamais, ni l'API ses cookies). Des tampons d'1 Mo ; une réponse plus
    # grosse (les historiques d'une collection, plusieurs Mo) passe par un fichier temporaire si le
    # navigateur la lit lentement.
    location ~ ^/api/(species|status|health)(/|$) {
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_buffers 128 8k;
    }

    # Le catalogue et les prix, de même, ensemble : 10 par seconde et par visiteur, 300 d'un coup.
    # Une page en demande une à trois (la page Catalogue : les séries, une série, ses prix ; une
    # fiche : l'historique de sa carte, à chaque carte voisine), plus, à la première, les prix de la
    # collection par paquets fixes de 200 cartes (5 000 cartes, plusieurs extensions : 25
    # demandes) ; « Chercher les images » (Réglages), au plus une par série de la collection, quatre
    # à la fois.
    location ~ ^/api/(catalog|prices)(/|$) {
        limit_req zone=api_data burst=300 nodelay;
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_buffers 128 8k;
    }

    # Ses routes coûteuses : 2 par seconde et par visiteur, 10 d'un coup au plus (la page Valeur en
    # demande une par paquet de 1 000 cartes possédées, une seule jusqu'à 1 000 ; « Copier pour
    # Cardmarket », de même une par paquet de 1 000 ids, l'une après l'autre).
    location ~ ^/api/(histories|wants)$ {
        limit_req zone=api_heavy burst=10 nodelay;
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_buffers 128 8k;
    }

    # Le compte (Better Auth) : il limite déjà les tentatives de connexion et de création, mais une
    # déconnexion répétée passerait sans limite ; 20 d'un coup au plus.
    location /api/auth/ {
        limit_req zone=api_auth burst=20 nodelay;
        proxy_pass $server;
        proxy_set_header Host $host;
    }

    # Les images : celles de l'API des données (toutes copiées d'avance par sa tâche `images` : une
    # qui manque est un 404, et le site montre alors la carte de substitution), gardées par nginx
    # (`proxy_cache`) et par les navigateurs un an, sans redemande (l'API le dit : `immutable`).
    # Deux demandes d'une même image pas encore gardée n'en font qu'une (`proxy_cache_lock`) ; une
    # absence (404) n'est pas gardée. 20 par seconde et par visiteur, 1 100 d'un coup : la plus
    # grande page d'images, le Pokédex (1 025 pochettes, chargées au fil du défilement : une
    # quarantaine par seconde en le parcourant vite), passe d'un coup. Pour les pages du site
    # seulement (`Cross-Origin-Resource-Policy`) : un autre site ne les affiche pas.
    location /images/ {
        limit_req zone=images_req burst=1100 nodelay;
        rewrite ^/images/(.*)$ /v1/images/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_cache images;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        include /etc/nginx/security-headers.conf;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    # Le manifeste de l'app (installable) : nginx ne connaît pas son type, et `nosniff` interdit au
    # navigateur de le deviner.
    location = /manifest.webmanifest {
        include /etc/nginx/security-headers.conf;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Les fichiers à la racine du site (`/theme.js`, `/favicon.svg`, `/robots.txt`…), toujours
    # revalidés : servis s'ils existent, sinon 404, et non la page de l'app (`/favicon.ico`,
    # `/sitemap.xml` n'existent pas). Une adresse d'un seul segment avec une extension : jamais une
    # page de l'app, ni un pseudo (sans point), ni ce qui a son dossier (`/assets/`, `/images/`,
    # `/api/`, `/icons/`) ; `/manifest.webmanifest` et `/index.html` ont leur `location` exacte.
    location ~ ^/[^/]+\.[A-Za-z0-9]+$ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # La page de l'app, pour toute adresse de l'app (`location /`, plus bas) : toujours revalidée,
    # pour qu'un déploiement soit vu tout de suite (sa date gardée malgré `sub_filter`, pour un
    # 304) ; hors des moteurs de recherche, sauf les pages publiques (`$robots`) ; les espèces
    # préchargées pour qui a une session (`$species_preload`). Les aperçus de partage veulent
    # l'adresse complète de leur image : celle du site demandé (Caddy le sert en https).
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $robots;
        add_header Link $species_preload;
        sub_filter 'property="og:image" content="/' 'property="og:image" content="https://$host/';
        sub_filter_last_modified on;
    }

    # Routage côté client : /pokedex, /pokemon/25… reçoivent la page de l'app (`/index.html`,
    # plus haut) ; un robot d'aperçu, pour une adresse d'un seul segment, la page du serveur. Les
    # autres fichiers (`/icons/…`) : tels quels, toujours revalidés.
    location / {
        if ($vitrine_preview) {
            rewrite ^/([A-Za-z0-9_-]+)$ /api/vitrine/$1/apercu last;
        }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
