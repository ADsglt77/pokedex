# Le gabarit de la configuration de nginx : l'image nginx le remplit au démarrage depuis son
# environnement (`/etc/nginx/templates`), seulement les variables qu'elle connaît : le token du site
# pour l'API des données, `${DATA_API_TOKEN}` (son `.env`, `compose.yaml`). Les variables de nginx,
# sans accolades, restent telles quelles.

# Les images de l'API des données, gardées sur le disque de nginx : une image ne change jamais
# (l'API ne réécrit pas un fichier qui existe), chacune ne traverse qu'une fois. Perdues à la
# reconstruction du conteneur : l'API les redonne, sans rien télécharger.
proxy_cache_path /var/cache/nginx/images levels=1:2 keys_zone=images:10m max_size=4g
                 inactive=90d use_temp_path=off;

# Par visiteur : l'adresse que donne le tunnel Cloudflare (`cf-connecting-ip`), la seule qui le
# distingue (une requête sans elle, en local, n'est pas limitée). Les routes publiques coûteuses de
# l'API (jusqu'à une seconde de calcul pour les historiques de 1 025 cartes, sur la seule boucle
# du serveur) et la connexion : un visiteur ne peut pas bloquer le serveur, ni noyer son journal.
limit_req_zone $http_cf_connecting_ip zone=api_heavy:10m rate=2r/s;
limit_req_zone $http_cf_connecting_ip zone=api_auth:10m rate=2r/s;
limit_req_status 429;

# Les robots d'aperçu des messageries (Discord, WhatsApp…) qui lisent un lien partagé vers le Pokédex
# public d'un compte (`/pseudo`, toute adresse d'un seul segment) : ils ne lancent pas le JavaScript
# de l'app, le serveur leur fait une page à part, avec le pseudo et la progression
# (`/api/vitrine/<pseudo>/apercu`, `server/vitrine.ts`, la même liste) ; pour une page du site
# (`/connexion`), l'aperçu du site.
map "$http_user_agent|$uri" $vitrine_preview {
    default 0;
    "~*(discordbot|whatsapp|facebookexternalhit|twitterbot|slackbot|telegrambot|linkedinbot|skypeuripreview|redditbot|embedly).*\|/[A-Za-z0-9_-]+$" 1;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    # Ni la version de nginx dans les réponses, et les en-têtes de sécurité partout.
    server_tokens off;
    include /etc/nginx/security-headers.conf;
    # Une ligne de requête jusqu'à 16 Ko (8 Ko par défaut) : les 1 025 ids d'une collection
    # (`/api/histories?ids=…`, de 7 à 8 Ko) y tiennent, avec de la marge.
    large_client_header_buffers 4 16k;

    # Niveau 6 plutôt que 1 (le défaut) : le code rétrécit, pour un coût serveur négligeable.
    # `gzip_proxied` : les réponses de l'API aussi (celles déjà compressées, en gzip, passent
    # telles quelles). `text/javascript` : le type que donne nginx aux scripts récents ; le
    # manifeste de l'app aussi.
    gzip on;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml;

    # Le serveur et l'API des données (son propre `compose.yaml`, le réseau `pokedex-net`),
    # retrouvés par le DNS de Docker à chaque requête (au plus 10 s de cache) : quand leur conteneur
    # redémarre, il peut changer d'adresse ; résolue une fois au démarrage de nginx, elle serait
    # périmée (502) jusqu'au prochain redémarrage de nginx.
    resolver 127.0.0.11 valid=10s;
    set $server http://server:3000;
    set $data_api http://data-api:3001;

    # Fichiers produits par Vite, au nom unique (empreinte) : gardés un an par les navigateurs.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Le serveur de l'app (compte, collection, Pokédex public) : il donne lui-même ses en-têtes de
    # cache. Des tampons d'1 Mo en mémoire, assez pour ses réponses.
    location /api/ {
        proxy_pass $server;
        proxy_set_header Host $host;
        client_max_body_size 5m;
        proxy_buffers 128 8k;
    }

    # Les données (espèces, catalogue, prix, historiques, état des tâches) : l'API des données, sous
    # `/v1`, avec le token du site (le navigateur ne le voit jamais, ni l'API ses cookies). Des
    # tampons d'1 Mo ; une réponse plus grosse (les historiques d'une collection, plusieurs Mo)
    # passe par un fichier temporaire si le navigateur la lit lentement.
    location ~ ^/api/(species|catalog|prices|status|health)(/|$) {
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_buffers 128 8k;
    }

    # Ses routes coûteuses : 2 par seconde et par visiteur, 10 d'un coup au plus (la page Valeur,
    # « Copier pour Cardmarket » n'en demandent qu'une).
    location ~ ^/api/(histories|wants)$ {
        limit_req zone=api_heavy burst=10 nodelay;
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_buffers 128 8k;
    }

    # Le compte (Better Auth) : il limite déjà les tentatives de connexion et de création, mais une
    # déconnexion répétée passerait sans limite ; 20 d'un coup au plus.
    location /api/auth/ {
        limit_req zone=api_auth burst=20 nodelay;
        proxy_pass $server;
        proxy_set_header Host $host;
    }

    # Les images : celles de l'API des données (qui copie à la demande, 4 à la fois, celles qu'elle
    # n'a pas encore), gardées par nginx (`proxy_cache`) et par les navigateurs un an, sans
    # redemande (l'API le dit : `immutable`). Deux demandes d'une même image pas encore gardée n'en
    # font qu'une (`proxy_cache_lock`) ; une absence (404) n'est pas gardée.
    location /images/ {
        rewrite ^/images/(.*)$ /v1/images/$1 break;
        proxy_pass $data_api;
        proxy_set_header Authorization "Bearer ${DATA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_cache images;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
    }

    # Le manifeste de l'app (installable) : nginx ne connaît pas son type, et `nosniff` interdit au
    # navigateur de le deviner.
    location = /manifest.webmanifest {
        include /etc/nginx/security-headers.conf;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Routage côté client : /pokedex, /pokemon/25… reçoivent index.html, toujours revalidé
    # pour qu'un déploiement soit vu tout de suite.
    # Les aperçus de partage veulent l'adresse complète de leur image : celle du site demandé
    # (le tunnel le sert en https).
    location / {
        if ($vitrine_preview) {
            rewrite ^/([A-Za-z0-9_-]+)$ /api/vitrine/$1/apercu last;
        }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        sub_filter 'property="og:image" content="/' 'property="og:image" content="https://$host/';
        try_files $uri /index.html;
    }
}
